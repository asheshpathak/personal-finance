# Copy to .env.local for local development. Never commit the real file.
# On Vercel, set this as an Environment Variable instead.
#
# IMPORTANT: Vite inlines VITE_* values at BUILD time, not run time. Changing
# this in the Vercel dashboard has no effect until you redeploy.

# Base URL of the backend API — no trailing slash, no /api suffix.
# Local:      http://localhost:5001
# Production: https://your-service.up.railway.app
VITE_API_URL=http://localhost:5001
