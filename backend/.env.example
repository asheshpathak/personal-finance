# Copy to .env for local development. Never commit the real .env.
# On Railway, set these as service variables instead.

# MongoDB connection string.
# Local:  mongodb://localhost:27017/expense-app
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/expense-app?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/expense-app

# Secret used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# REQUIRED in production — the server refuses to start without it.
JWT_SECRET=

# Comma-separated browser origins allowed to call this API.
# Leave empty in development to accept any localhost port.
# In production set to your Vercel URL, e.g. https://your-app.vercel.app
CORS_ORIGINS=

# Railway injects PORT automatically; only set this locally if 5001 is taken.
PORT=5001

# Set to "production" on Railway. Enables the fail-fast secret checks.
NODE_ENV=development

# ── AI features (optional) ────────────────────────────────────────────────────
# Powers natural-language capture ("chai 30 cash"), the briefing on Home,
# the plan reviewer, and Ask Tetra.
#
# Leave this blank and every AI surface hides itself — the rest of the app is
# completely unaffected. There is no degraded mode and no broken button.
#
# Get a key at https://console.anthropic.com. It is read server-side only and is
# never sent to the browser.
ANTHROPIC_API_KEY=

# The model every AI feature runs on. Pinned here rather than left to a library
# default so an upgrade is a deliberate, reviewable change.
#
# Sonnet 5 is the default: ~2.5x cheaper than Opus 5 per token in both
# directions and, more to the point, it thinks less on the way to an answer.
# Nothing this app asks is a hard reasoning problem.
#
# claude-haiku-4-5 is supported and is what the scenario suite runs on. Two
# things differ and both are handled in code rather than left as traps:
#
#   · It REJECTS output_config.effort. Every route sets it, so the request is
#     built through a capability check (`supportsEffort` in lib/claude.ts) that
#     drops the parameter on models that would 400 on it.
#   · Its minimum cacheable prefix is 4,096 tokens against Sonnet's 1,024. A
#     context under the floor silently never caches — no error, no warning, and
#     `cache_creation_input_tokens` simply stays 0 while every request pays full
#     price for the whole prefix. The chat route logs a line when it happens.
#     Most accounts render well past 4,096 tokens once debts and a year of
#     category history are in; a brand-new one does not.
ANTHROPIC_MODEL=claude-sonnet-5

# Per-account ceiling on AI calls per rolling hour. This bounds the bill if a
# client ends up in a retry loop; it is not meant to ration normal use.
AI_REQUESTS_PER_HOUR=60
